# Copy these into your host's environment settings (this app does not read .env files itself).

# Public address of the site, used in email links. No trailing slash.
APP_URL=https://yourdomain.com

# Resend API key from https://resend.com/api-keys — leave unset locally to print emails to the console.
RESEND_API_KEY=re_xxxxxxxxxxxx

# Sender address. Must be on a domain you have verified in Resend.
EMAIL_FROM=My Website <hello@yourdomain.com>

NODE_ENV=production
PORT=3000
DB_FILE=data/app.db
