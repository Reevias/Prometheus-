<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center">
    <ImageView android:layout_width="96dp" android:layout_height="96dp" android:src="@mipmap/ic_launcher"
        android:contentDescription="Prometheus" />
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Opening Prometheus…" android:textColor="#E9EBEF" android:textSize="18sp" />
    <TextView android:id="@+id/where" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#7D8591" android:textSize="13sp" />
    <Button android:id="@+id/again" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="Open Prometheus" android:textAllCaps="false"
        android:backgroundTint="#D92D43" android:textColor="#FFFFFF" />
    <Button android:id="@+id/change" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Change address" android:textAllCaps="false"
        style="?android:attr/borderlessButtonStyle" android:textColor="#AAB0BA" />
</LinearLayout>
